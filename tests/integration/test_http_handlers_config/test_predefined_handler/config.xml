
<clickhouse>
    <http_handlers>
        <rule>
            <methods>GET</methods>
            <headers><XXX>xxx</XXX></headers>
            <url>/test_predefined_handler_get</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT name, value FROM system.settings WHERE name = {setting_name:String}</query>
            </handler>
        </rule>
        <rule>
            <url><![CDATA[regex:/query_param_with_url/(?P<setting_name_1>[^/]+)]]></url>
            <headers>
                <XXX><![CDATA[regex:(?P<setting_name_2>.+)]]></XXX>
            </headers>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT name, value FROM system.settings WHERE name = {setting_name_1:String} OR name = {setting_name_2:String}</query>
                <content_type>application/generic+one</content_type>
                <http_response_headers>
                  <X-Test-Http-Response-Headers-Works>it works</X-Test-Http-Response-Headers-Works>
                  <X-Test-Http-Response-Headers-Even-Multiple>also works</X-Test-Http-Response-Headers-Even-Multiple>
                </http_response_headers>
            </handler>
        </rule>
        <rule>
            <methods>POST</methods>
            <url>/test_predefined_handler_post_body</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>INSERT INTO test_table(id, data) SELECT {id:UInt32}, {_request_body:String}</query>
            </handler>
        </rule>
        <!-- Inline INSERT data and _request_body binding must coexist for legacy predefined handlers. -->
        <rule>
            <methods>POST</methods>
            <url>/test_predefined_handler_inline_insert_and_request_body</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>INSERT INTO test_table (id, data) SETTINGS insert_deduplication_token={_request_body:String} VALUES (101, 'INLINE')</query>
            </handler>
        </rule>
        <!-- An INSERT SELECT reading inline input() data can also bind the POST body. -->
        <rule>
            <methods>POST</methods>
            <url>/test_predefined_handler_inline_input_and_request_body</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>INSERT INTO test_table (id, data) SELECT x, {_request_body:String} FROM input('x UInt32') FORMAT CSV
102</query>
            </handler>
        </rule>
        <!-- Streamed INSERT data stays available when _request_body is bound by the URL. -->
        <rule>
            <methods>POST</methods>
            <url>/test_predefined_handler_streamed_insert_and_request_body</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>INSERT INTO test_table (id, data) SETTINGS insert_deduplication_token={_request_body:String} FORMAT CSV</query>
            </handler>
        </rule>
        <!-- Legacy predefined handlers can bind the body on POST even without a method filter. -->
        <rule>
            <url>/test_predefined_handler_body_no_methods</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT {_request_body:String}</query>
            </handler>
        </rule>
        <rule>
            <methods>GET,POST</methods>
            <url>/test_predefined_handler_body_get_post</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT {_request_body:String}</query>
            </handler>
        </rule>
        <rule>
            <methods>DELETE</methods>
            <url>/test_predefined_handler_delete_body</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT {_request_body:String}</query>
            </handler>
        </rule>
        <rule>
            <methods>POST,DELETE</methods>
            <url>/test_predefined_handler_delete_insert_body</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>INSERT INTO test_table(id, data) FORMAT TSV</query>
            </handler>
        </rule>
        <rule>
            <methods>DELETE</methods>
            <url>/test_predefined_handler_delete_no_body</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT {value:UInt32}</query>
            </handler>
        </rule>
        <!-- A DELETE-only handler may modify an existing session temporary table under readonly = 2. -->
        <rule>
            <methods>POST</methods>
            <url>/test_predefined_handler_create_temporary</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>CREATE TEMPORARY TABLE test_predefined_temp (id UInt32) ENGINE = Memory</query>
            </handler>
        </rule>
        <rule>
            <methods>DELETE</methods>
            <url>/test_predefined_handler_drop_temporary</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>DROP TEMPORARY TABLE test_predefined_temp</query>
            </handler>
        </rule>
        <rule>
            <methods>POST</methods>
            <url>/test_predefined_handler_post_form_body</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT {value:String}</query>
            </handler>
        </rule>

        <rule>
            <methods>GET</methods>
            <url>/test_predefined_handler_request_parser_backtracks</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT length([[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]][1])</query>
            </handler>
        </rule>

        <rule>
            <methods>GET</methods>
            <url>/test_predefined_handler_settings_param</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT getSetting('max_threads') SETTINGS max_threads = {threads:UInt64}</query>
            </handler>
        </rule>

        <rule>
            <methods>GET</methods>
            <url>/test_predefined_handler_request_parser_limits</url>
            <handler>
                <type>predefined_query_handler</type>
                <query>SELECT ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((1))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))</query>
            </handler>
        </rule>

        <rule>
            <methods>GET</methods>
            <url>/test_predefined_handler_auth_with_password</url>
            <handler>
                <type>predefined_query_handler</type>
                <user>with_password</user>
                <query>SELECT currentUser()</query>
            </handler>
        </rule>
        <rule>
            <methods>GET</methods>
            <url>/test_predefined_handler_auth_with_password_fail</url>
            <handler>
                <type>predefined_query_handler</type>
                <user>incorrect_user</user>
                <query>SELECT currentUser()</query>
            </handler>
        </rule>
        <rule>
            <methods>GET</methods>
            <url>/test_predefined_handler_auth_without_password</url>
            <handler>
                <type>predefined_query_handler</type>
                <user>without_password</user>
                <query>SELECT currentUser()</query>
            </handler>
        </rule>
    </http_handlers>
</clickhouse>
